# Copy this file to .env and fill in real values. Never commit .env itself.

GEMINI_API_KEY=
GITHUB_TOKEN=

# owner/repo of the codebase this agent will answer questions about
TARGET_REPO=

# Which chat LLM the agent uses: "gemini" (free tier, rate-limited) or
# "ollama" (local, no rate limit, needs Ollama running with the model pulled)
CHAT_PROVIDER=ollama
OLLAMA_MODEL=gpt-oss:20b

ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_KEYSPACE=default_keyspace